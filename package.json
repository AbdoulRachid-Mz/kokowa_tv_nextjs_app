{
  "name": "front-end",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "mysql -u root -p kokowa_tv < scripts/seed.sql",
    "db:reset": "npm run db:drop && npm run db:migrate",
    "db:drop": "mysql -u root -p -e 'DROP DATABASE IF EXISTS kokowa_tv'",
    "db:reset:postgres": "node scripts/reset-db.js",
    "db:migrate:postgres": "node scripts/migrate.js",
    "db:seed:postgres": "psql -U $DB_USER -d kokowa_tv -f database/seed.sql",
    "db:test": "npx tsx lib/db/test-connection.ts",
    "db:setup": "npm run db:reset:postgres && npm run db:migrate:postgres && npm run db:seed:postgres"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dgram": "^1.0.1",
    "dns": "^0.2.2",
    "dotenv": "^17.2.3",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.5.0",
    "lucide-react": "^0.552.0",
    "mysql2": "^3.15.3",
    "next": "16.0.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
