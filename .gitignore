# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

*.rar
*.zip
*.7z
front-end.rar

/services/service-account.json
/services/google-services.json
/services/google-services*.json
/database/*firebase-adminsdk*.json
database/*firebase-adminsdk*.json

# --- Sécurité : données réelles et clés, jamais dans le dépôt ---
# Exports de la base (contiennent e-mails, téléphones, empreintes de mots de passe)
/database/data/
/database/backups/
# Clés de compte de service Firebase
*firebase-adminsdk*.json
*-service-account*.json
